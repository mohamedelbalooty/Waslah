# Waslah local environment template
# Copy to `.env` for local development. Placeholders only — never commit real credentials (spec SC-007).

# Shared runtime mode (consumed by apps/api, apps/web)
NODE_ENV=development

# apps/api — HTTP listen port (server.ts default fallback: 4000)
PORT=4000

# PostgreSQL — consumed by the postgres container and reserved for DB specs (DB-01+)
DATABASE_URL=postgresql://waslah:waslah@localhost:5432/waslah
POSTGRES_USER=waslah
POSTGRES_PASSWORD=waslah
POSTGRES_DB=waslah

# Redis — local data service wiring; consumed by queue/cache specs arriving later
REDIS_URL=redis://localhost:6379

# CI-only Turborepo remote-cache credentials are GitHub repository secrets,
# deliberately NOT declared here: TURBO_TOKEN, TURBO_TEAM
